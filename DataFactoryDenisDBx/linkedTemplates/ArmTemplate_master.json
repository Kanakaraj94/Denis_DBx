{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DataFactoryDenisDBx"
		},
		"Adls2Adf_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Adls2Adf_ls'"
		},
		"AzureDatabricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricks'"
		},
		"Adls2Adf_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdatadenis.dfs.core.windows.net/"
		},
		"AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0815-042518-rsy4k1uq"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://denisDBxKV.vault.azure.net/"
		},
		"Blob2Adf_ls_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "BlobConnStr"
		},
		"Mongo2Adf_ls_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "MongoConnStr"
		},
		"Mongo2Adf_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "denis_dbx_db"
		},
		"MySql2Adf_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"MySql2Adf_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "denis_dbx_db"
		},
		"MySql2Adf_ls_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DataFactoryDenisDBx_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Adls2Adf_ls_accountKey": {
						"value": "[parameters('Adls2Adf_ls_accountKey')]"
					},
					"AzureDatabricks_accessToken": {
						"value": "[parameters('AzureDatabricks_accessToken')]"
					},
					"Adls2Adf_ls_properties_typeProperties_url": {
						"value": "[parameters('Adls2Adf_ls_properties_typeProperties_url')]"
					},
					"AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"Blob2Adf_ls_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('Blob2Adf_ls_properties_typeProperties_connectionString_secretName')]"
					},
					"Mongo2Adf_ls_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('Mongo2Adf_ls_properties_typeProperties_connectionString_secretName')]"
					},
					"Mongo2Adf_ls_properties_typeProperties_database": {
						"value": "[parameters('Mongo2Adf_ls_properties_typeProperties_database')]"
					},
					"MySql2Adf_ls_properties_typeProperties_server": {
						"value": "[parameters('MySql2Adf_ls_properties_typeProperties_server')]"
					},
					"MySql2Adf_ls_properties_typeProperties_database": {
						"value": "[parameters('MySql2Adf_ls_properties_typeProperties_database')]"
					},
					"MySql2Adf_ls_properties_typeProperties_username": {
						"value": "[parameters('MySql2Adf_ls_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "DataFactoryDenisDBx_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'DataFactoryDenisDBx_ArmTemplate_0')]"
			]
		}
	]
}